# Konfigurasi deployment Madrasah Diniyah Takmiliyah Annajiyah 2
# Backend/database terpusat akan dikonfigurasi pada tahap server setelah revisi aplikasi selesai.

# Contoh alamat aplikasi ketika dijalankan di server/laptop:
VITE_APP_URL="http://localhost:5173"
# Optional API origin. Leave empty when frontend and /api share one origin
# through the production reverse proxy (recommended).
VITE_API_URL=

# Isi variabel backend/database nanti pada tahap deployment server.
# Jangan menyimpan kata sandi, token, atau secret produksi di repository.
