# Madrasah Diniyah — contoh konfigurasi deployment
# Salin ke environment server/secret manager. Jangan commit secret produksi.

# Frontend
VITE_APP_URL="http://localhost:5173"
# Kosongkan bila frontend dan /api memakai origin yang sama melalui reverse proxy.
VITE_API_URL=

# Backend
NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN="https://madrasah.example.org"

# MySQL 8.4+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=madrasah
DB_USER=madrasah_app
DB_PASSWORD="CHANGE_ME"

# Penyimpanan privat upload (foto santri, dokumen, tanda tangan Raport).
# Gunakan path absolut persisten di server dan sertakan dalam strategi backup.
UPLOAD_ROOT="/var/lib/madrasah/uploads"

# Authentication
# Wajib secret acak minimal 32 karakter; simpan di secret manager/server environment.
AUTH_JWT_SECRET="CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
AUTH_COOKIE_NAME=madin_session
AUTH_TOKEN_MINUTES=480
